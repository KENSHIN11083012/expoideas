{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(./mvnw test *)",
            "Bash(./mvnw verify *)",
            "Bash(./mvnw compile *)",
            "Bash(./mvnw spotless:apply *)",
            "Bash(./mvnw spotless:check *)",
            "Bash(npm ci)",
            "Bash(npm test *)",
            "Bash(npm run lint *)",
            "Bash(npm run format *)",
            "Bash(npm run format:check *)",
            "Bash(npm run build *)",
            "Bash(docker compose ps *)",
            "Bash(docker compose logs *)",
            "PowerShell(.\\mvnw.cmd test *)",
            "PowerShell(.\\mvnw.cmd verify *)",
            "PowerShell(.\\mvnw.cmd compile *)",
            "PowerShell(.\\mvnw.cmd spotless:apply *)",
            "PowerShell(.\\mvnw.cmd spotless:check *)",
            "PowerShell(npm ci)",
            "PowerShell(npm test *)",
            "PowerShell(npm run lint *)",
            "PowerShell(npm run format *)",
            "PowerShell(npm run format:check *)",
            "PowerShell(npm run build *)",
            "PowerShell(docker compose ps *)",
            "PowerShell(docker compose logs *)"
        ],
        "ask": [
            "Bash(git push *)",
            "Bash(docker compose down *)",
            "Bash(docker volume rm *)",
            "PowerShell(git push *)",
            "PowerShell(docker compose down *)",
            "PowerShell(docker volume rm *)"
        ],
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.local)",
            "Read(**/.env.*.local)",
            "Read(**/application-local.properties)",
            "Read(**/uploads/**)",
            "Read(qa/credenciales*)",
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git push * --force*)",
            "Bash(git push * -f)",
            "PowerShell(git push --force*)",
            "PowerShell(git push -f*)",
            "PowerShell(git push * --force*)",
            "PowerShell(git push * -f)"
        ]
    }
}
