# Variables para docker-compose.yml. Copia este archivo a .env (ignorado por git)
# y rellena cada valor. Nunca subas el .env al repositorio.

# Puerto del servidor donde se publica la app (http://servidor:PUERTO/expoideas/).
HTTP_PORT=8080

# Contraseñas de MySQL: largas y distintas entre sí.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Clave para firmar las sesiones. Genera una con: openssl rand -base64 32
JWT_SECRET=

# Correo (servidor SMTP de TI). Sin MAIL_HOST la plataforma funciona, pero no
# envía avisos (invitaciones, cuentas creadas, sustentaciones).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@unisimon.edu.co
# URL pública de la app, para los enlaces de los correos: https://<dominio>/expoideas
# Con MAIL_HOST y esta URL, el registro pide verificar el correo y funciona la
# recuperación de contraseña. Vacía, los avisos salen sin enlace y no se pide verificar.
APP_URL=

# Opcionales
# JWT_EXPIRATION=4h
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_DURATION=5m
# ALLOWED_ORIGINS=https://otro-origen.unisimon.edu.co
# DB_USERNAME=expoideas
# MAIL_AUTH=true
# MAIL_STARTTLS=true
